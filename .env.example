# Polymarket US API credentials (app -> Settings -> Trading API). NEVER commit
# the real values of this file. secret_key is a base64-encoded Ed25519 key.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Claude API key. Only used as a fallback probability estimate for markets that
# have no confident, well-covered sportsbook match (see ODDS_API_KEY below).
ANTHROPIC_API_KEY=sk-ant-...

# The Odds API key (https://the-odds-api.com) - pulls live moneyline odds from real
# sportsbooks so the agent can cross-reference them against Polymarket prices and
# find genuine value bets, instead of relying on an LLM guess. Leave blank to fall
# back to the (much weaker) Claude-only estimate for every market.
ODDS_API_KEY=

# Minimum number of bookmakers that must quote both sides of a game before its
# consensus probability is trusted as a betting signal.
MIN_BOOKMAKERS=3

# Minimum text-match confidence (0-1) required to link a Polymarket market to a
# specific sportsbook game. Lower = matches more markets but more false positives.
MATCH_CONFIDENCE=0.6

# Bankroll the Kelly sizing is computed against, in USD. Treated as a WEEKLY budget:
# once total stakes placed since Monday 00:00 UTC reach this amount, the agent stops
# opening new positions until the following Monday, when the count resets to zero.
BANKROLL_USD=100

# Fraction of full Kelly to actually stake (0.5 = half-Kelly). Lower is safer.
KELLY_MULTIPLIER=0.5

# Hard cap on any single position, as a fraction of BANKROLL_USD.
MAX_POSITION_PCT=0.05

# Hard cap on number of simultaneously open positions.
MAX_OPEN_POSITIONS=10

# Minimum model-vs-market edge required to place a bet at all.
MIN_EDGE=0.04

# true = log intended trades without submitting orders. Set to false to trade live.
DRY_RUN=true
