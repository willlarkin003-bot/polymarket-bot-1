# Polymarket US API credentials (app -> Settings -> Trading API). NEVER commit
# the real values of this file. secret_key is a base64-encoded Ed25519 key.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Claude API key. Only used as a fallback probability estimate for markets that
# have no confident, well-covered sportsbook match (see ODDS_API_KEY below).
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the Claude fallback signal. Must be a real, currently-available
# model ID - an invalid one fails silently into "no signal" for every market, so
# if bets stop happening, check ANTHROPIC_MODEL first.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# The Odds API key (https://the-odds-api.com) - pulls live moneyline odds from real
# sportsbooks so the agent can cross-reference them against Polymarket prices and
# find genuine value bets, instead of relying on an LLM guess. Leave blank to fall
# back to the (much weaker) Claude-only estimate for every market.
ODDS_API_KEY=

# How long (seconds) to reuse sportsbook odds for a sport before re-fetching, across
# scheduled runs - not just within one. The Odds API free tier is 500 requests/month;
# on a 15-minute cron with no cross-run caching that's exhausted in ~2 days. 1200s
# (20 min) keeps a few sports comfortably within the free tier.
ODDS_CACHE_TTL_SECONDS=1200

# Minimum number of bookmakers that must quote both sides of a game before its
# consensus probability is trusted as a betting signal.
MIN_BOOKMAKERS=3

# Minimum text-match confidence (0-1) required to link a Polymarket market to a
# specific sportsbook game. Lower = matches more markets but more false positives.
MATCH_CONFIDENCE=0.6

# Bankroll the Kelly sizing is computed against, in USD. Treated as a WEEKLY budget:
# once total stakes placed since Monday 00:00 UTC reach this amount, the agent stops
# opening new positions until the following Monday, when the count resets to zero.
BANKROLL_USD=100

# Fraction of full Kelly to actually stake (0.5 = half-Kelly). Lower is safer.
KELLY_MULTIPLIER=0.5

# Hard cap on any single position, as a fraction of BANKROLL_USD.
MAX_POSITION_PCT=0.05

# Hard cap on number of simultaneously open positions (resets weekly, same as
# BANKROLL_USD - see README "Weekly bankroll reset").
MAX_OPEN_POSITIONS=25

# Minimum model-vs-market edge required to place a bet at all. Lower = more
# bets qualify, but each one is a thinner, less-certain edge.
MIN_EDGE=0.025

# How many open sports markets to scan per round, ranked by volume. Raising
# this looks at more games (more chances to find a value bet) without
# changing how selective MIN_EDGE/MIN_BOOKMAKERS are.
MARKET_FETCH_LIMIT=150

# A market resolving within this many days counts as "near-term". Near-term
# markets always get first claim on the week's MAX_OPEN_POSITIONS slots -
# see MAX_LONG_DATED_POSITIONS below and README "Weekly bankroll reset".
NEAR_TERM_WINDOW_DAYS=9

# Hard cap on how many of the week's MAX_OPEN_POSITIONS slots can go to a
# market resolving *outside* NEAR_TERM_WINDOW_DAYS (season-long futures,
# award winners, etc.) - including markets with no known resolution date at
# all. The rest of the weekly budget is reserved for markets resolving soon.
MAX_LONG_DATED_POSITIONS=5

# Only bet on markets whose implied odds (Polymarket's own price, converted
# to American odds) fall in this range - keeps the bot away from both heavy
# favorites and extreme longshots (e.g. risking $25 to win $2500). A market
# priced outside this band is skipped entirely, same as failing MIN_EDGE.
MIN_AMERICAN_ODDS=-150
MAX_AMERICAN_ODDS=600

# true = log intended trades without submitting orders. Set to false to trade live.
DRY_RUN=true

# Login for the local dashboard (dashboard.py). Leave both blank to keep it
# open with no login (fine if you only ever open it on this PC). Set BOTH to
# turn on a login screen - required before exposing the dashboard outside
# this machine, e.g. via an ngrok tunnel (see README "View from your phone").
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional: a free static ngrok domain (claimed under Domains in your ngrok
# dashboard) so your public dashboard link never changes across restarts.
# Only read by start_public_dashboard.bat - leave blank to get a random URL
# each time instead. See README "View from your phone".
NGROK_DOMAIN=
