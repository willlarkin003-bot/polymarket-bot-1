# Wallet that signs and funds orders. NEVER commit the real value of this file.
POLYMARKET_PRIVATE_KEY=0xyourprivatekey
POLYMARKET_FUNDER_ADDRESS=0xyourpolymarketproxywalletaddress
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137

# Claude API key used for probability estimation.
ANTHROPIC_API_KEY=sk-ant-...

# Bankroll the Kelly sizing is computed against, in USD.
BANKROLL_USD=1000

# Fraction of full Kelly to actually stake (0.5 = half-Kelly). Lower is safer.
KELLY_MULTIPLIER=0.5

# Hard cap on any single position, as a fraction of BANKROLL_USD.
MAX_POSITION_PCT=0.05

# Hard cap on number of simultaneously open positions.
MAX_OPEN_POSITIONS=10

# Stop trading for the day once realized losses exceed this fraction of BANKROLL_USD.
MAX_DAILY_LOSS_PCT=0.10

# Minimum model-vs-market edge required to place a bet at all.
MIN_EDGE=0.04

# true = log intended trades without submitting orders. Set to false to trade live.
DRY_RUN=true
